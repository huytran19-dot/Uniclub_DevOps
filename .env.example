# ==========================================
# MySQL Database Configuration
# Lưu ý: Mật khẩu MySQL (root & user) được lưu tại:
# - secret/db_root_password.txt
# - secret/db_password.txt
# ==========================================
MYSQL_DATABASE=uniclub
MYSQL_USER=uniclub_user
MYSQL_PORT=3307

# ==========================================
# phpMyAdmin Configuration
# ==========================================
PMA_PORT=8081

# ==========================================
# Backend Security (JWT)
# Lưu ý: JWT_SECRET được lưu tại: secret/jwt_secret.txt
# ==========================================
JWT_EXPIRATION=86400000

# ==========================================
# Cloudinary Configuration
# Lưu ý: CLOUDINARY_API_SECRET được lưu tại: secret/cloudinary_api_secret.txt
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key

# ==========================================
# VNPay Configuration
# Lưu ý: VNPAY_HASH_SECRET được lưu tại: secret/vnpay_hash_secret.txt
# ==========================================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_RETURN_URL=http://localhost/admin/payment/vnpay-return

# ==========================================
# Ports Configuration
# ==========================================
BACKEND_PORT=8080
FRONTEND_PORT=80
