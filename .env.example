# ==========================================
# MySQL Database Configuration
# Lưu ý: Mật khẩu MySQL (root & user) được lưu tại:
# - secret/db_root_password.txt
# - secret/db_password.txt
# ==========================================
MYSQL_DATABASE=uniclub
MYSQL_USER=uniclub_user
MYSQL_PORT=3307

# ==========================================
# phpMyAdmin Configuration
# ==========================================
PMA_PORT=8081

# ==========================================
# Backend Security (JWT)
# Lưu ý: JWT_SECRET được lưu tại: secret/jwt_secret.txt
# ==========================================
JWT_EXPIRATION=86400000

# ==========================================
# Cloudflare R2 Configuration
# Lưu ý: R2_SECRET_KEY được lưu tại: secret/r2_secret_key.txt
# ==========================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_BUCKET_NAME=uniclub-images
R2_PUBLIC_URL=https://your-public-url.r2.dev

# ==========================================
# VNPay Configuration
# Lưu ý: VNPAY_HASH_SECRET được lưu tại: secret/vnpay_hash_secret.txt
# Khi lên VPS, đổi http://localhost sang http://<IP_VPS> hoặc https://<DOMAIN>
# ==========================================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_RETURN_URL=http://localhost/payment/vnpay-return
VNPAY_IPN_URL=http://localhost/api/vnpay/ipn

# ==========================================
# Frontend Build Configuration
# ==========================================
VITE_API_URL=/api

# ==========================================
# Ports Configuration
# ==========================================
BACKEND_PORT=8080
FRONTEND_PORT=80
